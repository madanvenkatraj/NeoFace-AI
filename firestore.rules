rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 6 &&
             data.uid is string && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is number &&
             data.updatedAt is number &&
             data.uid == request.auth.uid &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('preferences' in data) || data.preferences is map);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().updatedAt == request.time && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt;
      allow delete: if false;

      function isValidExportSetting(data) {
        return data.keys().hasAll(['id', 'userId', 'name', 'resolution', 'frameRate', 'compression', 'createdAt', 'updatedAt']) &&
               data.keys().size() == 8 &&
               data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
               data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
               data.name is string && data.name.size() <= 100 &&
               data.resolution is string && data.resolution.size() <= 20 &&
               data.frameRate is number &&
               data.compression is string && (data.compression == 'low' || data.compression == 'medium' || data.compression == 'high' || data.compression == 'lossless') &&
               data.createdAt is number &&
               data.updatedAt is number &&
               data.userId == request.auth.uid;
      }

      match /exportSettings/{settingId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(settingId) && isValidExportSetting(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isSignedIn() && request.auth.uid == userId && isValidExportSetting(incoming()) && incoming().updatedAt == request.time && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      function isValidSwapResult(data) {
        return data.keys().hasAll(['id', 'userId', 'resultUrl', 'isVideo', 'createdAt']) &&
               data.keys().size() <= 8 &&
               data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
               data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
               data.resultUrl is string && data.resultUrl.size() <= 1024 &&
               data.isVideo is bool &&
               data.createdAt is number &&
               data.userId == request.auth.uid &&
               (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1024)) &&
               (!('qualityMode' in data) || (data.qualityMode is string && data.qualityMode.size() <= 20)) &&
               (!('facesSwapped' in data) || data.facesSwapped is number);
      }

      match /swapHistory/{resultId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(resultId) && isValidSwapResult(incoming()) && incoming().createdAt == request.time;
        allow update: if false; // history is immutable
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    function isValidJob(data) {
      return data.keys().hasAll(['id', 'userId', 'status', 'progress', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 6 &&
             data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.status is string && (data.status == 'queued' || data.status == 'processing' || data.status == 'completed' || data.status == 'failed') &&
             data.progress is number &&
             data.createdAt is number &&
             data.updatedAt is number &&
             data.userId == request.auth.uid;
    }

    match /jobs/{jobId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(jobId) && isValidJob(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidJob(incoming()) && incoming().updatedAt == request.time && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
